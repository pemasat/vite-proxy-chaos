{
  "name": "vite-plugin-chaos-proxy",
  "version": "0.1.0",
  "description": "Vite plugin that injects proxy chaos with random errors and response delays.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pemasat/vite-proxy-chaos.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/pemasat/vite-proxy-chaos/issues"
  },
  "homepage": "https://github.com/pemasat/vite-proxy-chaos#readme",
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.6.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "vite": ">=5 <9"
  },
  "dependencies": {
    "micromatch": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
